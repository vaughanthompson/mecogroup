halfDark = rgba(0,0,0,0.45)
lightGrey = rgba(222,222,222,1.0)
mainBG = rgba(245,245,245,1.0)


padXXL = 20vw
padXL = 15vw
padL = 10vw
padM = 7vw
padStd = 5vw
padXS = 3vw
padXXS = 1vw

marXL = 15vw
marL = 10vw
marM = 7vw
marStd = 5vw
marXS = 3vw
marXXS = 1vw



fontStack = "Satoshi-VR", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

//responsive breakpoint & media queries
mBreakPoint = 750px
tBreakPoint = 1100px
sdBreakPoint = 1200px
dBreakPoint = 1500px
lgBreakPoint = 2100px

phoneRule = "screen and (max-width: mBreakPoint )"
tabletRule = "screen and (min-width: mBreakPoint) and (max-width: tBreakPoint )"
desktopRule = "screen and (min-width: tBreakPoint) and (max-width: dBreakPoint )"
lgdesktopRule = "screen and (min-width: lgBreakPoint)"

smallDesktop = "screen and (min-width: mBreakPoint) and (max-width: sdBreakPoint )"


mtrigger = "screen and (max-width: tBreakPoint )"
ttrigger = "screen and (min-width: mBreakPoint )"
dtrigger = "screen and (min-width: tBreakPoint )"

phLandscape = "screen and (max-width: mBreakPoint) and (orientation: landscape)"
tbLandscape = "screen and (min-width: mBreakPoint) and (max-width: tBreakPoint) and (orientation: landscape)"

ie = "all and (-ms-high-contrast: none), (-ms-high-contrast: active)"

$hideItAll = none !important

// responsive logos
logoDimens = 40vw


// misc blocks
marginNo = @block {
    margin: 0
}
marginM = @block {
    margin-bottom: 2vh
}
marginL = @block {
    margin-left: 2vw
}
marginR = @block {
    margin-right: 2vw
}
marginT = @block {
    margin-bottom: 4vh
}
marginBT = @block {
    margin-bottom: 1.5vh
}
marginVT = @block {
    margin-top: 2vh
    margin-bottom: 2vh
}
marginALL = @block {
    margin: 2vh
}
wh100 = @block {
    width:100%
    height:100%
}
test = @block {
    border:1px solid red
}
borderBtm = @block {
    border-bottom: 1px solid brand1
}



// heights
fullH = 100vh
largeH = 80vh
halfH = 50vh
smallH = 25vh

navHeight = 6vh
navHeightL = 11vh
navSpacer = 7vh
navSpacerL = 15vh



// basic defaults
html, body
    width: 100%
    height: 100%
    font-family: fontStack
body
    font-size: 16px
    // background: linear-gradient(top, white, brand1)
body
    background-color: white
    color: brand2


hr
    border: none
    border-bottom: 1px solid brand1
    margin:0

hr.small
    border-bottom: 2px solid brand1
    width:100px 




.reverse hr
    border-bottom: 1px solid white

.noPad
    padding: 0 !important
// blend modes

.nowrap 
    text-wrap: nowrap

.noPadBottom
    padding-bottom: 0 !important
.noPadTop
    padding-top: 0 !important
.noPadRight
    padding-right: 0 !important
.noPadLeft
    padding-left: 0 !important

.bgPosBottom
    background-position: -1px 100%

.marLXXS
    margin-left: marXXS
.marRXXS
    margin-right: marXXS
.marTXXS
    margin-top: marXXS
.marBXXS
    margin-bottom: marXXS

