// custom typo
ul
    margin-bottom: 2em
    padding-left: 0
    padding-right: 0

ul li
    font-size: 1.1em
    line-height: 1.4em
    margin-bottom: 0em
    list-style-type: none
    padding-bottom: 1.1em
    padding-top: 1em
    padding-right: 1em
    border-bottom: 1px solid brand2
ul li:last-child
    border-bottom: none
/*ul li:first-child
    padding-top: 0*/
ul.light li
    border-bottom: 1px solid whiteAlp50
ul p
    margin-bottom: 0
    margin-top: 0

.reverse ul
    border-top: 1px solid brand1
    border-bottom: 1px solid brand1
    @media phoneRule
        width: 100%

.reverse li
    color: brand4
    border-bottom: 1px solid brand1
    
    
.reverse li strong 
    color: white
.reverse .galleryElement ul,
.reverse .galleryElement li
    border:none


 ul.simpleGrid
    border:none
.simpleGrid li
    font-size: 1.2em
    line-height: 1.3em


// picturefill-bg and image teaser
*.picturefill-background a
    color: brand1 
@media ttrigger
    *.picturefill-background.lighten1,
    *.picturefill-background.lighten1 a,
    *.picturefill-background.lighten2,
    *.picturefill-background.lighten2 a
    *.picturefill-background.darktext,
    *.picturefill-background.darktext a
        color: blackAlp50
    *.picturefill-background.lighttext,
    *.picturefill-background.lighttext a
        color: white      
*.picturefill-background a
    //text-decoration: underline

nav a:hover
    color: brand1
p a:link,
p a:visited
    color: brand3
    text-decoration: underline    
p a:hover
    color: brand2

.activeLink, 
li a:hover,
*.picturefill-background a:hover
    color: white !important
    transition: 300ms
