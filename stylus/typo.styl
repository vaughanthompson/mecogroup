h1, h2, h3, h4 ,h5, h6
    margin: 0
    margin-bottom: 10px

// defaults   
h1
    font-weight: 600
    font-size: 4.5em
    line-height: 1em
    letter-spacing: -0.025em
    text-wrap: balance
    
h2
    font-weight: 600
    font-size: 3em
    line-height: 1.03em
    letter-spacing: -0.025em
    text-wrap: balance

h3
    font-weight: 500
    font-size: 2.25em
    line-height: 1.02em
    letter-spacing: -0.02em
h4
    font-weight: 400
    font-size: 1.5em
    line-height: 1.1em
h5
    font-weight: 400
    font-size: 1.25em
    line-height: 1.15em
h6
    font-weight: 400
    font-size: 1.15em
    line-height: 1.15em
    letter-spacing: -0.01em
p
    font-weight: 400
    font-size: 1.15em
    line-height: 1.2em
    letter-spacing: -0.01em
    margin: 0



@media phoneRule
    h1
        font-size: 3em
        
    h2
        font-size: 2.5em

    h3
        font-size: 2.25em

    h4
        font-size: 1.5em

    h5
        font-weight: 400
        font-size: 1.25em
        line-height: 1.15em
    h6
        font-weight: 400
        font-size: 1.15em
        line-height: 1.15em
        letter-spacing: -0.01em
    p
        font-weight: 400
        font-size: 1.15em
        line-height: 1.2em
        letter-spacing: -0.01em
        margin: 0

@media lgdesktopRule
    p, h6
        font-size: 1.5em
@media smallHeightDesktop
    h1
        font-size: 3em


a.siteLogo:hover
    cursor: pointer

strong 
    font-weight: 600
    //letter-spacing: -0.015em

// modify typo
.small
    font-size: 0.95em    
.balanced,
div.fullW p
    text-wrap: balance !important





// footer
body > footer
    font-size: 0.9em
    line-height: 1em
    text-align: center 
    font-weight: 400  
body > footer nav 
    display: flex
    flex-direction: column
body > footer a
body > footer i:before
    color: white !important; 
body > footer .links a
    color: white !important; 
    display: inline-block
    padding: 5px 3px 3px 3px 
    margin: marXXS*0.45 0
    border-bottom: 1px solid brand1

body > footer a:hover,
body > footer i:hover:before
    transition: 0.5s
    color: brand1mid !important;
    
body > footer .links a:hover 
    color: brand1mid !important;
    text-decoration: none
    transition: 0.5s
    border-bottom: 1px solid brand1mid

body > footer a.activeLink
    color: brand0 !important; 
    @media dtrigger
        border-left: 3px solid brand0
        margin-left: padXXS*1.15







.reverse
    color: white
.reverse a:not(.ctaButton)
    color: white
    text-decoration: underline

.balanced 
    text-wrap: balanced

.noUppercase
    text-transform: none




//text effects 
.responsiveLarge
    font-size: 5vw
    line-height: 95%
    letter-spacing: -0.3vw
    //font-weight: 700
    @media phoneRule
        font-size:6.5vh
        line-height: 110%
    @media lgdesktopRule
        font-size:5vw
.responsiveLarge .outline
    letter-spacing: -0.2vw
.outline
    -webkit-text-stroke: 1.25px
    -webkit-text-fill-color: rgba(0,0,0,0)
.strokeBrand0
    -webkit-text-stroke-color: brand0
.strokeBrand1
    -webkit-text-stroke-color: brand1
.strokeBrand2
    -webkit-text-stroke-color: brand2
.strokeBrand3
    -webkit-text-stroke-color: brand3
.strokeBrand4
    -webkit-text-stroke-color: brand4
.strokeBrand5
    -webkit-text-stroke-color: brand5
.strokeBrand6
    -webkit-text-stroke-color: brand6
.light
    font-weight: 300





.upperCase {text-transform: uppercase;}
.outlineCase-black {-webkit-text-stroke: 2px black;}
.outlineCase-white {-webkit-text-stroke: 2px white;}
.outlineCase-cyan1 {-webkit-text-stroke: 2px brand1}
.outlineCase-cyan2 {-webkit-text-stroke: 2px brand2}
.noTextFill {color: rgba(0,0,0,0.0);}







