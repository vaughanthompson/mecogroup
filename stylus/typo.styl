nav a:hover
    border-bottom-color: white !important;
*/


header > nav 
    padding-bottom: navHeight*0.125
    display: flex
    column-gap: padXXS*1.8
    @media dtrigger
        //padding: padXXS*1.5 padXXS padXXS padXXS
header > nav a:link
    //margin-right: marXS

nav a:link
    font-weight: 400
    display: inline-block
    font-size:navHeight*0.28
    @media phoneRule
        font-size:1em
    @media dtrigger
        font-size:navHeight*0.28
    @media lgdesktopRule
        font-size:1.2em
nav a:link.activeLink, nav a:visited.activeLink
    padding-bottom: padXXS*0.35
    color: brand3
    border-bottom: 2px solid white
nav a:link
    white-space: nowrap

nav a.subnav 
    margin-left: 2em

nav.vertical
    display: flex
    flex-direction: column
    align-items: flex-start
nav.vertical a
    margin-bottom: 4px

nav.leftSpaced
    display:flex
    column-gap: 1.5vw
    @media phoneRule
        flex-direction: column



nav a:not(.activeLink):link:after, 
nav a:not(.activeLink):visited::after 
    content: ""
    display: block
    width: 0
    border-bottom: 2px solid brand1
    transition: width 0.3s
    padding: 0 0 padXXS*0.35 0
nav a.effect:not(.activeLink):hover::after
    width: 100%




