/* banners and tiles */






.relative 
    position: relative

.gradientBlackFromBottomAndTop
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0, rgba(0,0,0,0.2) 25%,rgba(0,0,0,0.4) 60%,rgba(0,0,0,0.7))

.gradientBlackFromBottom 
    background: linear-gradient(to top, rgba(0,0,0,1.0), rgba(0,0,0,0.0) 30%)

.gradientBlackFromBottom2 
    background: linear-gradient(to top, rgba(0,0,0,1.0), rgba(0,0,0,0.0))

.gradientBlackFromTop 
    background: linear-gradient(to bottom, rgba(0,0,0,1.0), rgba(0,0,0,0.0))

.gradientBlackFromTop2 
    background: linear-gradient(to bottom, rgba(0,0,0,0.25), rgba(0,0,0,0.0) 10%)

.gradientGreyFromTop 
    background: linear-gradient(to bottom, rgba(0,0,0,0.10), rgba(0,0,0,0.0))

.gradientGreyFromTop2 
    background: linear-gradient(to bottom, rgba(0,0,0,0.10) 5%, rgba(0,0,0,0.0) 95%)

.gradientBlackFromLeft 
    background: linear-gradient(to right, rgba(0,0,0,1.0) , rgba(0,0,0,0.0))

.gradientBlackFromTopLeft 
    background: linear-gradient(to bottom right, rgba(0,0,0,0.8), rgba(0,0,0,0.0))

.gradientBlackFromBottomLeft 
    background: linear-gradient(to top right, rgba(0,0,0,0.8), rgba(0,0,0,0.0))

.gradientBlackFromRight 
    background: linear-gradient(to left, rgba(0,0,0,0.8), rgba(0,0,0,0.0) 50%)

.gradientBlackFromRight2
    background: linear-gradient(to left, rgba(0,0,0,1.0), rgba(0,0,0,0.0))

.gradientBlackFromTopRight 
    background: linear-gradient(to bottom left, rgba(0,0,0,0.8), rgba(0,0,0,0.0))

.gradientBlackBottomRight 
    background: linear-gradient(to top left, rgba(0,0,0,0.8), rgba(0,0,0,0.0))



