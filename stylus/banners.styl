/* banner ribbons */
.overflowHidden 
    overflow: hidden

.ribbonBase 
    position: absolute
    right: -25%
    width: 100%
    padding: 1.65vw 0 1vw 0
    transform: rotate(30deg)
    box-shadow: 0 20px 10px rgba(0, 0, 0, 0.5)
    background-color: black
    color: white
    text-align: center

@media mtrigger
    .ribbonBase     
        right:-10%
        bottom: 5%
        transform: rotate(10deg)
        box-shadow: 0 20px 10px rgba(0, 0, 0, 0.5)
        padding: 1.5vh 0 1vh 0
        font-size: 80%
        z-index: 1
        width: 120%
    
@media dtrigger
    .ribbonBase  
        top: 11%
    


/* new banners typography */
.banner h1,
.banner h2,
.banner h3,
.banner h4,
.banner h5,
.banner h6 
    margin: 0
    padding: 0
    position: relative









/* width control */
.heroBanner 
    width:100%

@media phoneRule
    .subHeroBanner 
        width:100%
    
@media tabletRule
    .subHeroBanner 
        width:100%
        flex:1 0 50vw
    
@media dtrigger
    .subHeroBanner 
        width:50vw

@media phoneRule
    .tileBanner 
        width:100%

@media tabletRule
    .tileBanner 
        width:100%
        flex:1 0 50vw
    
@media dtrigger
    .tileBanner 
        width:25vw
    









@media phoneRule
    .bannerContent 
        padding: 0
        padding-left: 8vw 
        padding-right: 8vw
    

@media tabletRule
    .bannerContent 
        padding-left: 5vw 
        padding-right: 5vw
    .subHeroBanner .bannerContent 
        padding-left: 5vw 
        padding-right: 5vw
    .tileBanner .bannerContent 
        padding-left: 5vw 
        padding-right: 5vw
    
@media dtrigger
    .bannerContent 
        padding-left: 10vw 
        padding-right: 10vw
    .subHeroBanner .bannerContent 
        padding-left: 5vw 
        padding-right: 5vw
    .tileBanner .bannerContent 
        padding-left: 3vw 
        padding-right: 3vw
    







.setContentBG 
    background-size: contain
    background-repeat: no-repeat
    background-position: center
    display: flex
    flex-direction: column
    justify-content: center
    align-items: flex-start

.centreMe 
    align-items: center
    text-align: center

.bannerLinkImage 
    display: flex 
    align-items: center
    justify-content: center
    width: 100% 
    height: 100%

.bannerLinkImage.twoRow 
    flex-wrap: wrap
.bannerLinkImage.twoRow > div:last-child
    align-self: flex-end

/* test banner mode */
.banner.test .bannerLinkImage > div 
    border: 1px solid blue
.banner.test .setContentBG 
    background-color: rgba(255,255,255,0.2)
.banner.test .bannerInnerContent 
    border: 1px solid cyan



.bannerContent.noPadForce 
    padding-left: 0 
    padding-right: 0

.bannerInnerContent 
    display: flex
    justify-content: center 
    align-items: center 
    width: 100%  

@media phoneRule
    .bannerInnerContent 
        height: 70vh
        padding-top: 5vh
        padding-bottom: 5vh
    .tileBanner .bannerInnerContent 
        height: auto
    

@media tabletRule
    .bannerInnerContent 
        height: 75vh    
    .heroBanner .bannerInnerContent,
    .subHeroBanner .bannerInnerContent,
    .tileBanner .bannerInnerContent 
        height: 45vw
    .panel .bannerInnerContent 
        padding-top: 3em
        padding-bottom: 3em
    

@media dtrigger
    .bannerInnerContent 
        height: 70vh
        padding-top: 5vh
        padding-bottom: 5vh
    .tileBanner .bannerInnerContent 
        height: 18vw    
    .rowBannerHolder 
        display: flex
        flex-wrap: nowrap
    .bannerInnerContent.masthead
        height: 40vh


.overrideHeight 
    min-height: 10vw
    height: auto
    max-height: 100%

.shadowSection 
    position: relative
    box-shadow: 0 0px 50px 25px rgba(0, 0, 0,0.4)

.onTop
    position: absolute
    z-index: 1

.flexApart
    display: flex
    justify-content: space-between



